pipeline {
     agent any

     environment {
         IMAGE = "globalmedicare-frontend"
         TAG = "latest"
         REGISTRY = "docker.io/arshabk"
     }
     stages {
         stage('Clone') {
             steps {
                 git branch: 'feature/frontend', url: 'https://github.com/arshaprajesh/medicare_frontend.git'
                 echo 'Repository cloned'

             }
         }
         stage('Ensure KIND Cluster Exists') {
              steps {
                  echo 'Checking for existing KIND cluster...'
                  sh '''
                      if kind get clusters | grep -q "kind"; then
                          echo "KIND cluster already exists. Continuing..."
                      else
                          echo "No cluster found. Creating new KIND cluster..."
                          kind create cluster
                          echo "KIND cluster created successfully."
                      fi
                  '''
              }
         }
         stage('Build frontend') {
             steps {
                 dir('globalmedicare-app') {
                     sh 'npm install'
                     sh 'npm run build'
                     echo 'JAR built successfully.'
                 }
             }
         }
         stage('Docker build'){
             steps {
                 dir('globalmedicare-app') {
                     sh 'docker build -t $REGISTRY/$IMAGE:$TAG .'
                     echo 'image successfully created.'
                 }
             }
         }
         stage('Docker push'){
             steps {
                 withCredentials([usernamePassword(credentialsId: 'dockerhub_creds',
                 usernameVariable: 'USER', passwordVariable: 'PASS')]) {
                 sh 'echo $PASS | docker login -u $USER --password-stdin'
                 sh 'docker push $REGISTRY/$IMAGE:$TAG'

                 echo 'login successfully.'
                 }

             }
         }
         stage('deploy to kubernetes'){
             steps {
                 dir('globalmedicare-app') {
                      sh 'kubectl apply -f k8s/frontend-deployment.yaml'
                      sh 'kubectl apply -f k8s/frontend-service.yaml'
                      echo ' successfully deployed'
                 }
             }
         }
     }
}